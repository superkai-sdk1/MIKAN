# Production environment for /opt/mikan/deploy/.env (read by docker compose).
# deploy.sh never overwrites the remote .env — create it once on the server from this file.

# Public domain served by Caddy (automatic HTTPS). Default: the server IP via sslip.io.
DOMAIN=95-170-124-192.sslip.io
PUBLIC_URL=https://95-170-124-192.sslip.io

# HOST/PORT/DATA_DIR/TZ are fixed in docker-compose.yml.

# `openssl rand -hex 32`
JWT_SECRET=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

TELEGRAM_BOT_TOKEN=
BOT_ENABLED=true
# Telegram is blocked from the server: all Bot API calls and file downloads go through the
# Cloudflare Worker reverse proxy (transparent pass-through of https://api.telegram.org/*).
# No trailing slash.
TELEGRAM_API_ROOT=https://telegram-proxy.example.workers.dev

# Claude through Polza (Anthropic-compatible Messages API, bearer auth).
AI_BASE_URL=https://polza.ai/api
AI_API_KEY=
AI_AUTH=bearer
AI_MODEL=google/gemini-3.1-flash-lite
AI_HTTPS_PROXY=
AI_MAX_TOKENS=4096
AI_DAILY_LIMIT=500
AI_CHAT_HOURLY_LIMIT=20
AI_IMAGE_MODEL=

# Оплата по QR-коду (СБП) через Точку — см. deploy/README.md «Оплата по QR-коду».
TOCHKA_API_URL=https://enter.tochka.com/uapi
TOCHKA_JWT=
TOCHKA_MERCHANT_ID=
TOCHKA_ACCOUNT_ID=

# Копия ежедневного бэкапа вне сервера — см. deploy/README.md «Бэкапы вне сервера».
# Любое S3-совместимое хранилище; пример — Yandex Object Storage. Нужны все пять обязательных
# значений (endpoint, bucket, два ключа, ключ шифрования), иначе копии не уходят и сотрудникам приходит оповещение.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=mikan/
# `openssl rand -base64 32`. Сохраните копию ключа вне сервера: без него бэкап не расшифровать.
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_KEEP=30

# Push-уведомления на iPhone сотрудников (APNs) — см. deploy/README.md «Push-уведомления».
# Нужны все четыре значения; без них push не отправляются, неполная настройка пишется в лог при запуске.
# Key ID ключа из Apple Developer → Keys (10 символов).
APNS_KEY_ID=
# Team ID студии: G99YH9UK8C.
APNS_TEAM_ID=
# Bundle ID приложения: com.mikanstudio.crm.
APNS_BUNDLE_ID=
# Содержимое файла AuthKey_<KEY_ID>.p8 в base64 одной строкой: base64 -i AuthKey_<KEY_ID>.p8 | tr -d '\n'
APNS_PRIVATE_KEY=

LOG_LEVEL=info
