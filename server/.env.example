# MIKAN STUDIO server — copy to .env and fill in. Never commit the real .env.

# HTTP
PORT=3000
HOST=127.0.0.1
# Public origin of the API (informational; used in logs).
PUBLIC_URL=http://localhost:3000

# Data directory: mikan.db (SQLite), uploads/, backups/ (daily at ~04:00 studio time, 14 kept).
DATA_DIR=./data

# Auth. JWT_SECRET must be at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# First admin, created only when the database has no employees yet.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Telegram bot (long polling). The bot also needs "enabled" in Settings → Bot.
TELEGRAM_BOT_TOKEN=
BOT_ENABLED=false
# Telegram Bot API root, no trailing slash. Default https://api.telegram.org.
# In production (Telegram blocked) point it at the Cloudflare Worker reverse proxy,
# e.g. https://telegram-proxy.<account>.workers.dev — all API calls and file downloads go through it.
TELEGRAM_API_ROOT=https://api.telegram.org

# AI (Claude via an Anthropic-compatible Messages API).
# AI_BASE_URL empty = Anthropic directly; for Polza use https://polza.ai/api
AI_BASE_URL=https://polza.ai/api
# Empty key = AI disabled (the bot then forwards clients to staff).
AI_API_KEY=
# bearer = "Authorization: Bearer <key>" (default when AI_BASE_URL is set); x-api-key = Anthropic direct.
AI_AUTH=bearer
# Polza model id; for Anthropic direct use claude-opus-5-5.
AI_MODEL=anthropic/claude-opus-5.5
# Optional HTTPS proxy for AI requests, e.g. http://user:pass@host:port
AI_HTTPS_PROXY=
# Max output tokens per AI call (adaptive thinking counts toward it). Default 4096.
AI_MAX_TOKENS=4096
# Cost guards (0 = unlimited): AI replies per studio-local day, and per chat per hour.
AI_DAILY_LIMIT=500
AI_CHAT_HOURLY_LIMIT=20

# SBP QR payments through Tochka Bank (optional; all three of JWT/merchant/account enable them).
# JWT: internet bank → «Интеграции и API» → JWT-ключ with SBP permissions (ReadSBPData, EditSBPData, ReadCustomerData).
# Then `node dist/scripts/tochka-setup.js` (or `npx tsx src/scripts/tochka-setup.ts`) prints the merchant and account ids.
# Sandbox: TOCHKA_API_URL=https://enter.tochka.com/sandbox/v2, TOCHKA_JWT=sandbox.jwt.token,
# TOCHKA_MERCHANT_ID=MA0000086825, TOCHKA_ACCOUNT_ID=12345678901234567890/044525104 (QR codes cannot be paid there).
TOCHKA_API_URL=https://enter.tochka.com/uapi
TOCHKA_JWT=
# SBP merchant (ТСП) id, e.g. MA0000086825 — not the 15-digit internet-acquiring id.
TOCHKA_MERCHANT_ID=
# <20-digit account>/<BIC>, e.g. 40702810123456789012/044525104
TOCHKA_ACCOUNT_ID=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
